# Azure DevOps Personal Access Token (PAT).
# Needs: Code (Read & Write), Pull Request Threads (Read & Write).
AZURE_DEVOPS_PAT=

# Anthropic API key for the LLM reviewer.
ANTHROPIC_API_KEY=

# Path to the YAML configuration file describing targets and policy.
CONFIG_PATH=config/targets.yaml

# Path to the SQLite database file (created automatically if missing).
DATABASE_PATH=data/reviews.db

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
